{
  "name": "extract-raw-preview",
  "version": "0.1.0",
  "description": "Extract embedded JPEG/PNG previews from camera RAW files (CR2, CR3, NEF, ARW, RAF, DNG, ORF, RW2, PEF), TIFF, JPEG EXIF thumbnails, and Photoshop PSD/PSB. Pure JavaScript — Node.js and browser, no native decoder.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Dan Radenkovic",
    "email": "dan@radenkovic.org",
    "url": "https://radenkovic.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radenkovic/extract-raw-preview.git"
  },
  "bugs": {
    "url": "https://github.com/radenkovic/extract-raw-preview/issues",
    "email": "dan@radenkovic.org"
  },
  "homepage": "https://github.com/radenkovic/extract-raw-preview#readme",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/browser.js",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "extract-raw-preview": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "raw",
    "thumbnail",
    "preview",
    "extract",
    "jpeg",
    "jpg",
    "png",
    "camera",
    "photography",
    "dslr",
    "mirrorless",
    "canon",
    "cr2",
    "cr3",
    "nikon",
    "nef",
    "sony",
    "arw",
    "fujifilm",
    "raf",
    "adobe",
    "dng",
    "olympus",
    "orf",
    "panasonic",
    "rw2",
    "pentax",
    "pef",
    "tiff",
    "tif",
    "exif",
    "jpgfromraw",
    "previewimage",
    "photoshop",
    "psd",
    "psb",
    "embedded",
    "metadata",
    "image",
    "browser",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixtures": "node scripts/fixtures.ts",
    "fixtures:force": "node scripts/fixtures.ts --force",
    "fixtures:check": "node scripts/fixtures.ts --check",
    "fixtures:list": "node scripts/fixtures.ts --list",
    "fixtures:thumbs": "npm run build && node scripts/fixtures-thumbs.ts",
    "pretest": "npm run fixtures:check",
    "test": "npm run build && node --test test/",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^24.13.5",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
