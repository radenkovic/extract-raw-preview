{
  "name": "extract-raw-preview",
  "version": "1.1.0",
  "description": "Zero-dependency camera RAW thumbnail extractor for JavaScript. Extract embedded JPEG/PNG previews in Node.js and browsers from CR2, CR3, NEF, ARW, RAF, DNG, TIFF, PSD, and more—no native addons.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Dan Radenkovic",
    "email": "dan@radenkovic.org",
    "url": "https://radenkovic.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radenkovic/extract-raw-preview.git"
  },
  "bugs": {
    "url": "https://github.com/radenkovic/extract-raw-preview/issues",
    "email": "dan@radenkovic.org"
  },
  "homepage": "https://github.com/radenkovic/extract-raw-preview#readme",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/browser.js",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "extract-raw-preview": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "camera-raw",
    "raw-image",
    "raw-photo",
    "raw-thumbnail",
    "thumbnail-extractor",
    "preview-extractor",
    "extract-thumbnail",
    "extract-preview",
    "embedded-preview",
    "jpeg-preview",
    "exif-thumbnail",
    "jpgfromraw",
    "extractjpgfromraw",
    "previewimage",
    "raw",
    "thumbnail",
    "preview",
    "photography",
    "cr2",
    "cr3",
    "nef",
    "arw",
    "raf",
    "dng",
    "orf",
    "rw2",
    "pef",
    "tiff",
    "exif",
    "photoshop",
    "psd",
    "psb",
    "pure-javascript",
    "zero-dependency",
    "typescript",
    "nodejs",
    "browser",
    "client-side",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixtures": "node scripts/fixtures.ts",
    "fixtures:force": "node scripts/fixtures.ts --force",
    "fixtures:check": "node scripts/fixtures.ts --check",
    "fixtures:list": "node scripts/fixtures.ts --list",
    "fixtures:thumbs": "npm run build && node scripts/fixtures-thumbs.ts",
    "pretest": "npm run fixtures:check",
    "test": "npm run build && node --test 'test/**/*.test.mjs'",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
